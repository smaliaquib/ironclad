# AWS credentials are picked up from the standard chain (env vars, ~/.aws/credentials,
# instance/task role, etc). Only set these if you want to override that:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional - enables RAG. Set to the SSM parameter name the infra branch
# writes the knowledge base id to (terraform output from the infra branch:
# module.knowledge_base[0].ssm_parameter_name, e.g.
# /ironclad-dev/knowledge-base/id) - fetched once at startup via ssm:GetParameter.
# Leave empty for local dev without a knowledge base.
KNOWLEDGE_BASE_SSM_PARAM=

# Optional - enables tool use. Base URL of the mcp-gateway service (e.g.
# http://mcp-gateway.ironclad-dev.local:9000 in AWS, via Cloud Map). The
# agent fetches the current tool catalog from <url>/mcp (tools/list) and
# calls tools through the same endpoint (tools/call). Leave empty for local
# dev without a gateway - the agent then runs with no tools at all.
MCP_GATEWAY_URL=
