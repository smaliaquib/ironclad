VITE_ROUTER_URL=http://localhost:8080

# Only needed to test sign-in locally against a real deployed Cognito user
# pool - leave empty for local dev without auth (the default, matching
# REQUIRE_AUTH=false on the router).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Mirrors the infra's enable_auth - while "false" (the default), the app
# skips the login gate entirely instead of misreading /auth/whoami's
# fallback response (nginx's SPA fallback, since Lambda@Edge isn't
# attached) as "not authenticated".
VITE_ENABLE_AUTH=false
