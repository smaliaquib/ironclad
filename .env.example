# AWS credentials are picked up from the standard chain (env vars, ~/.aws/credentials,
# instance/task role, etc). Only set these if you want to override that:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional - enables RAG (Retrieve calls against this knowledge base woven
# into the prompt). Leave empty for local dev without a knowledge base.
KNOWLEDGE_BASE_ID=
